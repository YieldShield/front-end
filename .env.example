# Frontend environment
VITE_WALLETCONNECT_PROJECT_ID=
VITE_ENABLE_TESTNETS=true
VITE_DEFAULT_CHAIN=arbitrumSepolia
# Optional. Public frontend RPCs only. IPFS builds expose these values in static assets.
VITE_RPC_URL_421614=
# Optional. Comma-separated browser RPC fallbacks tried after VITE_RPC_URL_421614.
VITE_RPC_URLS_421614=
VITE_RPC_URL_31337=

# Points sources
VITE_POINTS_PROVIDER=browser
VITE_POINTS_BROWSER_FROM_BLOCK=
VITE_POINTS_BROWSER_FINALITY_CONFIRMATIONS=20
VITE_POINTS_BROWSER_BLOCK_CHUNK_SIZE=50000
VITE_POINTS_BROWSER_POOL_ADDRESS_CHUNK_SIZE=50
VITE_POINTS_BROWSER_SCAN_TIMEOUT_MS=45000
VITE_POINTS_BROWSER_CACHE=true
VITE_POINTS_SNAPSHOT_BASE_URL=
VITE_POINTS_SNAPSHOT_MANIFEST_URL=
VITE_POINTS_SNAPSHOT_CID=
VITE_POINTS_SNAPSHOT_GATEWAYS=https://ipfs.io/ipfs/{cid},https://dweb.link/ipfs/{cid}
VITE_POINTS_SNAPSHOT_DNSLINK_NAME=
VITE_POINTS_SNAPSHOT_DNSLINK_GATEWAYS=
VITE_POINTS_SNAPSHOT_EXPECTED_CHAIN_ID=421614
VITE_POINTS_SNAPSHOT_REGISTRY_ADDRESS=
VITE_POINTS_SNAPSHOT_REGISTRY_CHAIN_ID=421614
VITE_POINTS_SNAPSHOT_ALLOWED_SIGNERS=
VITE_POINTS_SNAPSHOT_SIGNATURE_THRESHOLD=0
VITE_POINTS_SNAPSHOT_VERIFY_HASHES=true
VITE_POINTS_GRAPHQL_URL=
VITE_PONDER_GRAPHQL_URL=
VITE_PONDER_API_URL=
