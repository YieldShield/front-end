{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "abis/**/*.json"
  ]
}
